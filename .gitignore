# Large model binaries — use Git LFS or share separately
models/*.pkl
models/*.pt

# Estado local del encoder: manifiesto de entrenamiento y temporales de guardado
# atómico (describen modelos locales, que de por sí no se versionan)
models/*.meta.json
models/*.tmp

# Token-vector cache (derivado del modelo fastText de 1 GB; regenerable)
models/token_vectors.json

# ETH-80 dataset (205 MB) — download separately. El corte train/test si se
# versiona, con rutas relativas a data/eth80 (stage1_dataset.make_splits lo
# restaura a splits.json con rutas absolutas)
data/*
!data/eth80/
data/eth80/*
!data/eth80/splits_relative.json

# Imágenes de muestra para la app (derivadas de ETH-80; locales, no se versionan)
app_sample_images/

# ConceptNet corpus (474 MB)
cache/conceptnet-assertions-5.7.0.csv.gz

# Python cache
__pycache__/
*.pyc
*.pyo

# realtime_lab: material derivado de ETH-80 (regenerable con
# export_phone_images.py / make_print_sheet.py; mismo criterio que data/)
realtime_lab/phone_test_images/
realtime_lab/phone_test_images.zip
realtime_lab/hoja_impresion_eth80.pdf

